.git
.gitignore
.gitattributes

# Docker files (tidak perlu di-copy ke image)
docker-compose.yml
docker-compose*.yml
Dockerfile
.dockerignore

# Node
node_modules
npm-debug.log

# Laravel cache & logs (akan di-generate ulang di container)
