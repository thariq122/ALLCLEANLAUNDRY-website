# ==========================================
# Railway Environment Variables Template
# ==========================================
# Copy these variables to Railway Dashboard → Settings → Variables
# Replace placeholder values with actual values from Railway

# App Configuration
APP_NAME="All Clean Laundry"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://your-app-name.up.railway.app

# Database Configuration (Railway MySQL Plugin)
# These will be auto-injected by Railway if you use MySQL plugin
DB_CONNECTION=mysql
DB_HOST=${{MYSQLHOST}}
DB_PORT=${{MYSQLPORT}}
DB_DATABASE=${{MYSQLDATABASE}}
DB_USERNAME=${{MYSQLUSER}}
DB_PASSWORD=${{MYSQLPASSWORD}}

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue & Cache
CACHE_STORE=database
QUEUE_CONNECTION=database

# Logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Mail (optional)
MAIL_MAILER=log

# Filesystem
FILESYSTEM_DISK=local

# Broadcasting
BROADCAST_CONNECTION=log

# Other
BCRYPT_ROUNDS=12
